<Window x:Class="BootPilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BootPilot — 计划任务自启管家"
        Width="940" Height="820" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Bg}"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Icon="app.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="PowerGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource B.Accent}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <!-- 圆心 (8,9) r=5.2；缺口 240°~300°（正上方 60°）。
                 弧从 300° 顺时针经右→下→左到 240°，跨度 300°，
                 所以 large-arc=1、sweep=1 才自洽。 -->
            <Setter Property="Data"
                    Value="M 8,2.4 L 8,8 M 10.6,4.5 A 5.2,5.2 0 1 1 5.4,4.5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 顶栏 ============ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource B.Border}"
                BorderThickness="0,0,0,1" Padding="26,13">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource B.Accent}">
                        <Viewbox Width="19" Height="19">
                            <Canvas Width="16" Height="16">
                                <Path Style="{StaticResource PowerGlyph}" Stroke="#FFFFFF" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BootPilot" FontSize="15.5" FontWeight="Bold"
                                   Foreground="{StaticResource B.Text}" />
                        <TextBlock Text="计划任务自启管家 · 拖进来就能开机自启"
                                   FontSize="11.5" Foreground="{StaticResource B.TextFaint}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="AdminBadge" CornerRadius="6" Padding="9,4" Margin="0,0,10,0"
                            VerticalAlignment="Center" Background="#F2F4F8">
                        <TextBlock x:Name="AdminBadgeText" Text="按需提权" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{StaticResource B.TextSub}" />
                    </Border>
                    <Button Content="打开任务计划程序" Style="{StaticResource BtnSecondary}"
                            Click="OpenTaskScheduler_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 主体 ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,20,26,26">

                <!-- 拖拽区 -->
                <Border x:Name="DropZone" Height="126" Background="#FFFFFF"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                        CornerRadius="13" AllowDrop="True" Cursor="Hand"
                        DragEnter="DropZone_DragEnter" DragOver="DropZone_DragOver"
                        DragLeave="DropZone_DragLeave" Drop="DropZone_Drop"
                        MouseLeftButtonUp="DropZone_Click">
                    <Grid>
                        <Rectangle x:Name="DropDash" RadiusX="9" RadiusY="9" Margin="7"
                                   Stroke="#CBD5E5" StrokeThickness="1.6" StrokeDashArray="5 4"
                                   IsHitTestVisible="False" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="38" Height="38" CornerRadius="11" Background="#EFF4FE"
                                    HorizontalAlignment="Center">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="16" Height="16">
                                        <Path Style="{StaticResource PowerGlyph}" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock x:Name="DropTitle" Text="把程序或文件拖到这里"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource B.Text}"
                                       HorizontalAlignment="Center" Margin="0,9,0,0" />
                            <TextBlock x:Name="DropSub"
                                       Text="也可以点这里浏览选择 · 支持 exe / bat / lnk / 任意文档"
                                       FontSize="11.5" Foreground="{StaticResource B.TextFaint}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 设置卡片 -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="自启设置" Style="{StaticResource T.Section}" />
                        <TextBlock Text="填好下面几项，点右下角按钮即可创建计划任务。"
                                   Style="{StaticResource T.Hint}" Margin="0,3,0,15" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource T.Label}" Text="任务名称" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TbName" Style="{StaticResource Input}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource T.Label}"
                                       Text="目标路径" Margin="0,10,0,0" />
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TbTarget" Style="{StaticResource Input}" />
                                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource BtnSecondary}"
                                        Height="34" Margin="8,0,0,0" Click="Browse_Click" />
                            </Grid>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource T.Label}"
                                       Text="启动参数" Margin="0,10,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbArgs"
                                     Style="{StaticResource Input}" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource T.Label}"
                                       Text="工作目录" Margin="0,10,0,0" />
                            <Grid Grid.Row="3" Grid.Column="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TbWorkDir" Style="{StaticResource Input}" />
                                <Button Grid.Column="1" Content="自动" Style="{StaticResource BtnSecondary}"
                                        Height="34" Margin="8,0,0,0" Click="AutoWorkDir_Click"
                                        ToolTip="取目标文件所在目录" />
                            </Grid>
                        </Grid>

                        <TextBlock Text="触发方式" Style="{StaticResource T.Label}" Margin="0,17,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="RbLogon" Style="{StaticResource CardRadio}"
                                         GroupName="Trigger" IsChecked="True" Checked="Trigger_Checked">
                                <StackPanel>
                                    <TextBlock Text="用户登录时" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="推荐。登录后自动运行，界面正常可见，不需要管理员权限。"
                                               FontSize="11.5" Foreground="{StaticResource B.TextFaint}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RbBoot" Grid.Column="2" Style="{StaticResource CardRadio}"
                                         GroupName="Trigger" Checked="Trigger_Checked">
                                <StackPanel>
                                    <TextBlock Text="系统启动时" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="不登录也运行，但没有桌面，界面类程序会看不见。需要管理员权限。"
                                               FontSize="11.5" Foreground="{StaticResource B.TextFaint}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <Grid Margin="0,17,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="DelayLabel" Style="{StaticResource T.Label}" Text="登录后延迟" />
                                <TextBox x:Name="TbDelay" Style="{StaticResource Input}" Width="58"
                                         Text="0" Margin="9,0,7,0" TextAlignment="Center"
                                         PreviewTextInput="TbDelay_PreviewTextInput" />
                                <TextBlock Text="秒" Style="{StaticResource T.Label}" />
                            </StackPanel>

                            <CheckBox x:Name="ChkAdmin" Grid.Column="1" Style="{StaticResource Chk}"
                                      Content="以最高权限运行" VerticalAlignment="Center" Margin="22,0,0,0" />

                            <Button x:Name="BtnAdd" Grid.Column="2" Content="添加自启项"
                                    Style="{StaticResource BtnPrimary}" Click="Add_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 列表卡片 -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="已添加的自启项" Style="{StaticResource T.Section}" />
                                <Border Background="{StaticResource B.AccentSoft}" CornerRadius="9"
                                        Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="CountText" Text="0" FontSize="11.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource B.Accent}" />
                                </Border>
                            </StackPanel>
                            <Button Content="刷新" Style="{StaticResource BtnMini}"
                                    HorizontalAlignment="Right" Click="Refresh_Click" />
                        </Grid>

                        <Border x:Name="EmptyHint" Visibility="Collapsed" Height="98" CornerRadius="10"
                                Background="#FAFBFD" BorderBrush="#E4E9F2" BorderThickness="1"
                                Margin="0,13,0,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="还没有自启项" FontSize="13"
                                           Foreground="{StaticResource B.TextSub}" HorizontalAlignment="Center" />
                                <TextBlock Text="把要自动启动的程序拖到上面的区域试试"
                                           FontSize="11.5" Foreground="{StaticResource B.TextFaint}"
                                           Margin="0,5,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="ItemsHost" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" CornerRadius="10"
                                            Padding="13,10" Margin="0,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#EDF0F6" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8FAFE" />
                                                        <Setter Property="BorderBrush" Value="#DCE5F3" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.62" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="34" Height="34" CornerRadius="9"
                                                    Background="#F0F5FE" VerticalAlignment="Center">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="16" Height="16">
                                                        <Path Style="{StaticResource PowerGlyph}" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource B.Text}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border CornerRadius="4" Padding="5,0,5,1" Margin="7,0,0,0"
                                                            Background="#F1F4FA" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                                                   Foreground="{Binding StateBrush}" />
                                                    </Border>
                                                    <Border CornerRadius="4" Padding="5,0,5,1" Margin="5,0,0,0"
                                                            Background="#FFF4E3" VerticalAlignment="Center"
                                                            Visibility="{Binding TargetMissing, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="目标已失效" FontSize="10.5"
                                                                   Foreground="{StaticResource B.Warn}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SubLine}" FontSize="11.5"
                                                           Foreground="{StaticResource B.TextFaint}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0"
                                                           ToolTip="{Binding TargetTip}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                        Margin="0,0,16,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TriggerText}" FontSize="11.5"
                                                           Foreground="{StaticResource B.TextSub}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding DelayText}" FontSize="10.5"
                                                           Foreground="{StaticResource B.TextFaint}"
                                                           HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="试运行" Style="{StaticResource BtnMini}"
                                                        Tag="{Binding Name}" Click="RunItem_Click" />
                                                <Button Content="{Binding ToggleText}" Style="{StaticResource BtnMini}"
                                                        Tag="{Binding}" Click="ToggleItem_Click" Margin="4,0,0,0" />
                                                <Button Content="删除" Style="{StaticResource BtnMiniDanger}"
                                                        Tag="{Binding}" Click="DeleteItem_Click" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="FooterHint" Style="{StaticResource T.Hint}" Margin="0,10,0,0"
                                   Text="提示：这些任务归在「任务计划程序 → 任务计划程序库」下，名字都以 BootPilot_ 开头。BootPilot 只管理这类任务，不会碰系统自带项。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 浮动提示 ============ -->
        <Border x:Name="Toast" Grid.Row="1" Visibility="Collapsed" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"
                Background="#1E2430" CornerRadius="20" Padding="20,10"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270"
                                  Opacity="0.22" Color="#101623" />
            </Border.Effect>
            <TextBlock x:Name="ToastText" Foreground="#FFFFFF" FontSize="12.5" />
        </Border>
    </Grid>
</Window>
